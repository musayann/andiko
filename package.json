{
  "name": "andiko",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev --filter=@andiko/web",
    "dev:desktop": "pnpm --filter @andiko/desktop tauri dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@andiko/web",
    "build:desktop": "pnpm --filter @andiko/desktop tauri build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.6.0"
}
