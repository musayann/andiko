{
  "name": "andiko",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Markdown editor with live preview, KaTeX, Mermaid, PDF export and share links, on the web and as a Mac app.",
  "homepage": "https://andiko.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musayann/andiko.git"
  },
  "bugs": {
    "url": "https://github.com/musayann/andiko/issues"
  },
  "keywords": [
    "markdown",
    "markdown-editor",
    "markdown-preview",
    "markdown-to-pdf",
    "local-first",
    "nextjs",
    "react",
    "tauri",
    "macos",
    "codemirror",
    "katex",
    "mermaid"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev --filter=@andiko/web",
    "dev:desktop": "pnpm --filter @andiko/desktop tauri dev",
    "build": "turbo build",
    "build:web": "turbo build --filter=@andiko/web",
    "build:desktop": "pnpm --filter @andiko/desktop tauri build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.6.0"
}
