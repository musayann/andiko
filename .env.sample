# Settings for the website (apps/web) and the Mac app (apps/desktop). Copy to .env
# and fill in what you need. Every variable is optional.
# Both apps read this file when `next dev` or `next build` starts, so restart them
# after a change. A value in apps/<app>/.env.local overrides it for that app only.
# NEXT_PUBLIC_* values are baked in at build time, the Mac app's too: a local
# `pnpm build:desktop` ships what is set here.

# Website, at runtime. Postgres database for shared documents (the Share button).
# Leave unset to hide sharing; everything else works without it. The table is
# created on first use. Local example, after:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=pg postgres
DATABASE_URL=postgres://postgres:pg@localhost:5432/postgres

# Both apps, at build time. Public origin for canonical links, the sitemap, robots.txt
# and Open Graph images. Defaults to https://andiko.app; set it when self-hosting
# elsewhere. The terms (/terms) name the site's address only when this is set.
# The Mac app calls this site for sharing and the PDF fallback, and links to it from
# its Help menu. Its CSP (apps/desktop/src-tauri/tauri.conf.json) only allows
# https://andiko.app, so put any other origin (a local one, or your own domain unless
# you also add it to connect-src) in apps/web/.env.local rather than here.
# NEXT_PUBLIC_SITE_URL=https://notes.example.com

# Website, at build time; the Mac app only uses NEXT_PUBLIC_CONTACT_EMAIL, for the
# Report link on shared documents and in sharing error messages.
# Who runs this instance, shown in its privacy policy (/privacy) and terms (/terms).
# Those pages and the links to them are only published when the name, email and
# region are set; the Report link on shared documents needs only the email. Both pages
# describe sharing, so set these with DATABASE_URL.
# When a company runs it, give its full legal name, legal form included, and its
# registered office and companies register entry, so both pages show the company as
# the one you deal with.
# The regions say where shared documents are stored (the database) and processed (the
# server). They only describe the deployment, so keep them in step with your Neon project
# and your Vercel Functions region. The server region is optional; the policy leaves it
# out when unset.
# NEXT_PUBLIC_OPERATOR_NAME=Example Ltd
# NEXT_PUBLIC_OPERATOR_ADDRESS=KG 7 Ave, Kigali, Rwanda
# NEXT_PUBLIC_OPERATOR_REGISTRATION=Registered in Rwanda, company code 123456789
# NEXT_PUBLIC_CONTACT_EMAIL=privacy@example.com
# NEXT_PUBLIC_DATABASE_REGION=EU (Frankfurt)
# NEXT_PUBLIC_SERVER_REGION=EU (Frankfurt)

# Website, at runtime. Chrome binary for PDF export, e.g. in Docker. Local development
# uses the Chrome downloaded by puppeteer, and Vercel/AWS Lambda use @sparticuz/chromium.
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
