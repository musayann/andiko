{
  "name": "@andiko/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "tauri": "tauri",
    "icon:car": "icons=$(pwd -P)/src-tauri/icons && out=$(mktemp -d) && xcrun actool \"$icons/andiko.icon\" --compile \"$out\" --output-partial-info-plist \"$out/info.plist\" --app-icon andiko --include-all-app-icons --target-device mac --minimum-deployment-target 26.0 --platform macosx --output-format human-readable-text && cp \"$out/Assets.car\" \"$icons/Assets.car\""
  },
  "dependencies": {
    "@andiko/core": "workspace:*",
    "@andiko/editor": "workspace:*",
    "@andiko/ui": "workspace:*",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "katex": "^0.18.9",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@andiko/config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@tauri-apps/cli": "^2.12.4"
  }
}
